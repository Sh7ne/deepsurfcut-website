/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; script-src 'self'; style-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Map tiles and user-initiated location are permitted only on the Chinese map page.
# Detach inherited values before replacement: matching policies otherwise combine.
/RapidSurfingMap
  ! Content-Security-Policy
  ! Permissions-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.amap.com https://*.autonavi.com https://*.bdimg.com https://*.bdstatic.com https://api.map.baidu.com; media-src 'self'; script-src 'self' 'unsafe-eval' https://webapi.amap.com https://api.map.baidu.com https://*.bdimg.com https://dlswbr.baidu.com; style-src 'self' 'unsafe-inline' https://api.map.baidu.com; connect-src 'self' https://*.amap.com https://*.autonavi.com https://api.map.baidu.com https://*.bdimg.com https://*.bdstatic.com; upgrade-insecure-requests; worker-src 'self' blob:; font-src 'self' data: https://webapi.amap.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

/device-preview/*
  X-Robots-Tag: noindex, follow

/404.html
  X-Robots-Tag: noindex, follow

/zh/404.html
  X-Robots-Tag: noindex, follow

/de/404.html
  X-Robots-Tag: noindex, follow

https://deepsurfcut.pages.dev/*
  X-Robots-Tag: noindex, follow

https://:branch.deepsurfcut.pages.dev/*
  X-Robots-Tag: noindex, follow
