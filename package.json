{
  "name": "deepsurfcut-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev",
    "test": "node --test tests/retention.test.mjs tests/seo.test.mjs tests/updates.test.mjs tests/performance.test.mjs tests/app-store-sync.test.mjs tests/release-workflow.test.mjs",
    "updates:generate": "node scripts/render-updates.mjs",
    "updates:sync": "node scripts/sync-app-store.mjs",
    "test:updates-browser": "node scripts/check-updates-browser.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "test:runtime": "node --test tests/runtime.test.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "playwright": "1.62.1",
    "wrangler": "4.131.2",
    "yaml": "2.9.1"
  }
}
